<Page
    x:Class="Assignment7.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{ThemeResource PageBackgroundBrush}">

    <Page.TopAppBar>
        <CommandBar Background="{ThemeResource SaccoBlueBrush}" Foreground="White" DefaultLabelPosition="Right">
            <CommandBar.Content>
                <TextBlock Text="UNITY SACCO" FontSize="21" FontWeight="Bold" VerticalAlignment="Center" Margin="20,0,24,0" />
            </CommandBar.Content>
            <AppBarButton Icon="Home" Label="Dashboard" Click="DashboardButton_Click" />
            <AppBarButton Icon="Contact" Label="Members" Click="MembersButton_Click" />
            <AppBarButton Icon="Money" Label="Accounts" Click="AccountsButton_Click" />
            <AppBarSeparator />
            <AppBarButton Icon="LeaveChat" Label="Sign out" Click="LogoutButton_Click" />
        </CommandBar>
    </Page.TopAppBar>

    <Grid Padding="24,20,24,30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBlock x:Name="WelcomeText" Text="Welcome" FontSize="30" FontWeight="SemiBold" Foreground="#172B3A" />
            <TextBlock x:Name="RoleText" Text="Staff dashboard" FontSize="15" Foreground="#647482" Margin="0,5,0,0" />
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <Hub x:Name="DashboardHub">
                <HubSection Header="OVERVIEW" IsHeaderInteractive="False">
                    <DataTemplate>
                        <Grid MaxWidth="1200">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="260" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" Background="White" CornerRadius="10" Padding="22">
                                    <StackPanel>
                                        <TextBlock Text="TOTAL MEMBERS" FontSize="12" FontWeight="SemiBold" Foreground="#647482" />
                                        <TextBlock Text="1,248" FontSize="34" FontWeight="Bold" Foreground="#123B63" Margin="0,12,0,0" />
                                        <TextBlock Text="Active SACCO members" FontSize="13" Foreground="#647482" Margin="0,5,0,0" />
                                    </StackPanel>
                                </Border>

                                <Border Grid.Column="1" Background="White" CornerRadius="10" Padding="22">
                                    <StackPanel>
                                        <TextBlock Text="TOTAL SAVINGS" FontSize="12" FontWeight="SemiBold" Foreground="#647482" />
                                        <TextBlock Text="UGX 684.5M" FontSize="30" FontWeight="Bold" Foreground="#123B63" Margin="0,12,0,0" />
                                        <TextBlock Text="Current savings balance" FontSize="13" Foreground="#647482" Margin="0,5,0,0" />
                                    </StackPanel>
                                </Border>

                                <Border Grid.Column="2" Background="White" CornerRadius="10" Padding="22">
                                    <StackPanel>
                                        <TextBlock Text="ACTIVE LOANS" FontSize="12" FontWeight="SemiBold" Foreground="#647482" />
                                        <TextBlock Text="UGX 312.8M" FontSize="30" FontWeight="Bold" Foreground="#123B63" Margin="0,12,0,0" />
                                        <TextBlock Text="Outstanding loan portfolio" FontSize="13" Foreground="#647482" Margin="0,5,0,0" />
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <Border Grid.Row="1" Background="White" CornerRadius="10" Padding="20" Margin="0,18,0,0">
                                <StackPanel>
                                    <TextBlock Text="Quick actions" FontSize="19" FontWeight="SemiBold" Foreground="#172B3A" />
                                    <StackPanel Orientation="Horizontal" Margin="0,15,0,0">
                                        <Button Content="View members" Click="MembersButton_Click" Margin="0,0,12,0" />
                                        <Button Content="View accounts" Click="AccountsButton_Click" Margin="0,0,12,0" />
                                        <Button Content="SACCO information" Click="InfoButton_Click" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </DataTemplate>
                </HubSection>

                <HubSection Header="SACCO INFORMATION" IsHeaderInteractive="False">
                    <DataTemplate>
                        <Grid MaxWidth="1200" Height="400">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.1*" />
                                <ColumnDefinition Width="1*" />
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Background="White" CornerRadius="10" Padding="28" Margin="0,0,16,0">
                                <StackPanel>
                                    <TextBlock Text="UNITY SACCO" FontSize="28" FontWeight="Bold" Foreground="#123B63" />
                                    <TextBlock Text="Savings and Credit Cooperative Society" FontSize="15" Foreground="#647482" Margin="0,5,0,25" />
                                    <TextBlock Text="Our purpose" FontSize="18" FontWeight="SemiBold" Foreground="#172B3A" />
                                    <TextBlock Text="We provide accessible savings, financial services, and member support while promoting responsible financial management." TextWrapping="Wrap" FontSize="15" Foreground="#52616D" Margin="0,8,0,20" />
                                    <TextBlock Text="Office hours: Monday to Friday, 8:00 AM to 5:00 PM" FontSize="14" Foreground="#52616D" />
                                    <TextBlock Text="Email: info@unitysacco.example" FontSize="14" Foreground="#52616D" Margin="0,8,0,0" />
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="1" Background="#123B63" CornerRadius="10" Padding="20">
                                <Canvas>
                                    <TextBlock Canvas.Left="25" Canvas.Top="25" Text="MEMBER GROWTH" Foreground="White" FontSize="18" FontWeight="SemiBold" />
                                    <Line X1="35" Y1="310" X2="410" Y2="310" Stroke="White" StrokeThickness="1" Opacity="0.5" />
                                    <Line X1="35" Y1="70" X2="35" Y2="310" Stroke="White" StrokeThickness="1" Opacity="0.5" />
                                    <Polyline Points="45,275 105,250 165,260 225,205 285,180 345,125 405,90" Stroke="#F2B233" StrokeThickness="5" />
                                    <Ellipse Canvas.Left="400" Canvas.Top="85" Width="10" Height="10" Fill="#F2B233" />
                                    <TextBlock Canvas.Left="42" Canvas.Top="320" Text="Jan" Foreground="White" FontSize="11" />
                                    <TextBlock Canvas.Left="160" Canvas.Top="320" Text="Mar" Foreground="White" FontSize="11" />
                                    <TextBlock Canvas.Left="278" Canvas.Top="320" Text="May" Foreground="White" FontSize="11" />
                                    <TextBlock Canvas.Left="395" Canvas.Top="320" Text="Jul" Foreground="White" FontSize="11" />
                                </Canvas>
                            </Border>
                        </Grid>
                    </DataTemplate>
                </HubSection>
            </Hub>
        </ScrollViewer>
    </Grid>
</Page>
